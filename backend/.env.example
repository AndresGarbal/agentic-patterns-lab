# The app runs with any subset of these set. Anything unset degrades to a
# no-op and logs a warning at startup, so local development needs no
# database, no Redis, and only one provider key.

# Providers. A model whose key is missing is skipped by the gateway.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=

# Postgres. Without it, budget checks pass and calls are not logged.
DATABASE_URL=

# Upstash Redis REST. Without both, rate limiting is disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Langfuse. Without both keys, calls are not traced.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Daily spend caps per provider, in USD. Setting one to 0 forces the gateway
# to fall through to the next provider, which is how to rehearse a fallback.
DAILY_BUDGET_ANTHROPIC_USD=2.00
DAILY_BUDGET_OPENAI_USD=2.00
DAILY_BUDGET_GROQ_USD=1.00
